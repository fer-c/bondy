{minimum_otp_vsn, "R28"}.
{erl_opts, [debug_info]}.

%% =============================================================================
%% REBAR
%% =============================================================================

{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, []}
]}.

%% Deps are resolved at the umbrella level (bondy_mst, app_config, utils,
%% memory, resulto, telemetry). Declared here only for standalone builds.
{deps, [
    %% Merkle Search Trees
    {bondy_mst,{
        git,
        "https://github.com/bondy-io/bondy_mst.git",
        {branch, "develop"}
    }}
]}.

%% =============================================================================
%% DOCS
%% =============================================================================

{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    {extras, [
        <<"README.md">>
    ]},
    {main, <<"README.md">>}
]}.
